
// send

#include <Arduino.h>
#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>
#include <LoRa.h>

// --- PIN LORA ---
#define LORA_SS    5
#define LORA_RST   14
#define LORA_DIO0  26

// --- PIN NRF ---
#define NRF_CE     27
#define NRF_CSN    4 

// --- PIN SPI (SHARED) ---
#define SCK_PIN    18
#define MISO_PIN   19
#define MOSI_PIN   23

RF24 radio(NRF_CE, NRF_CSN);
const char hex_chars[] = "0123456789ABCDEF";

uint8_t readNrfRegister(uint8_t reg) {
  uint8_t result;
  digitalWrite(NRF_CSN, LOW);
  SPI.transfer(reg & 0x1F); 
  result = SPI.transfer(0xFF);
  digitalWrite(NRF_CSN, HIGH);
  return result;
}

void setup() {
  Serial.begin(115200);
  SPI.begin(SCK_PIN, MISO_PIN, MOSI_PIN);

  // --- SETUP LORA ---
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);
  if (!LoRa.begin(433E6)) {
    Serial.println("LoRa Gagal!");
    while (1);
  }
  LoRa.setSpreadingFactor(12); // SF12 untuk jarak maksimal
  LoRa.setSyncWord(0x34);
  Serial.println("LoRa Terinisialisasi.");

  // --- SETUP NRF ---
  if (!radio.begin()) {
    Serial.println("NRF Gagal!");
    while (1);
  }
  radio.setAutoAck(false);
  radio.setPALevel(RF24_PA_MAX);
  radio.setDataRate(RF24_2MBPS);
  radio.stopListening();
  Serial.println("NRF Terinisialisasi.");
}

void loop() {
  String spectrumData = "";

  // 1. SCAN NRF (125 Channel)
  for (int ch = 0; ch < 125; ch++) {
    int hits = 0;
    for (int s = 0; s < 10; s++) {
      radio.setChannel(ch);
      radio.startListening();
      delayMicroseconds(500); 
      if (readNrfRegister(0x09) & 1) hits++;
      radio.stopListening();
    }
    if (hits > 15) hits = 15;
    spectrumData += hex_chars[hits];
  }

  // 2. KIRIM VIA LORA
  Serial.print("Mengirim data scan ke Gateway... ");
  LoRa.beginPacket();
  LoRa.print(spectrumData); // Kirim 125 karakter hex
  if (LoRa.endPacket()) {
    Serial.println("Sukses!");
  } else {
    Serial.println("Gagal!");
  }

  delay(2000); // Jeda antar scan/kirim
}